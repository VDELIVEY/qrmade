# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Superadmin credentials (stored securely, hashed in production DB)
SUPERADMIN_USERNAME=ministry
SUPERADMIN_PASSWORD_HASH=your-bcrypt-hash

# App Configuration
# NEXT_PUBLIC_APP_NAME is no longer used; app title is hardcoded in src/app/layout.tsx

# Server-only payment provider configuration
COLLECTUG_API_KEY=your-collectug-api-key
COLLECTUG_BASE_URL=https://collectug.com/api

# Server-only security configuration
# Generate with: openssl rand -base64 32


